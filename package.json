{
  "name": "myduit",
  "version": "1.0.0",
  "private": false,
  "description": "Progressive Web App pencatatan keuangan pribadi offline-first dengan antarmuka Claymorphism modern.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidTimoteus/PWA-MyDuit.git"
  },
  "author": "David Timoteus",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve": "node serve-dist.mjs",
    "lint": "eslint src/",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "check:format": "node src/lib/format.check.mjs",
    "test:kurs": "node src/lib/kurs.test.mjs",
    "test:backup": "node src/features/backup/backupDelete.test.mjs",
    "test:ocr": "node src/lib/ocrStruk.test.mjs",
    "test:filter": "node src/features/transaksi/mergeRiwayat.test.mjs && node src/features/transaksi/transaksiCache.test.mjs",
    "test:riwayat": "node src/features/budget/riwayatSaldo.test.mjs",
    "test:render": "node src/features/budget/render.test.mjs",
    "test:events": "node src/lib/eventContract.test.mjs",
    "test:classes": "node src/styles/classContract.test.mjs",
    "test:utang": "node src/features/utang/prefill.test.mjs",
    "test:struk": "node src/lib/strukMeta.test.mjs",
    "test:image": "node src/lib/imageFilters.test.mjs",
    "test:gemini": "node src/lib/geminiOcr.test.mjs",
    "test:provider": "node src/lib/ocrProvider.test.mjs",
    "test:transaksi": "node src/features/transaksi/transaksiSubmit.test.mjs && node src/features/transaksi/kalkulatorNominal.test.mjs",
    "test:popup": "node src/components/popupBoundary.test.mjs",
    "test:design": "node src/styles/designIntegrity.test.mjs",
    "test:theme": "node src/lib/theme.check.mjs && node src/styles/themeContract.test.mjs",
    "test:motion": "node src/lib/useScrollEffects.test.mjs",
    "test:audit": "node src/lib/keuanganAudit.test.mjs",
    "check": "npm run check:format && npm run test:kurs && npm run test:backup && npm run test:theme && npm run test:motion && npm run test:ocr && npm run test:struk && npm run test:image && npm run test:gemini && npm run test:provider && npm run test:offline && npm run test:audit && npm run test:filter && npm run test:riwayat && npm run test:render && npm run test:events && npm run test:classes && npm run test:utang && npm run test:transaksi && npm run test:popup && npm run test:design && npm run lint && npm run build",
    "fb:login": "firebase login",
    "fb:rules": "firebase deploy --only firestore:rules",
    "fb:indexes": "firebase deploy --only firestore:indexes",
    "fb:firestore": "firebase deploy --only firestore",
    "test:offline": "node src/lib/offlineSync.test.mjs"
  },
  "dependencies": {
    "@heyputer/puter.js": "^2.6.5",
    "chart.js": "^4.5.1",
    "firebase": "^12.18.0",
    "flatpickr": "^4.6.13",
    "impeccable": "^4.8.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tesseract.js": "^7.0.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "canvas": "^3.2.3",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "firebase-tools": "^15.28.2",
    "globals": "^15.0.0",
    "pdfjs-dist": "^6.3.289",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^1.3.0"
  }
}
