# Salin file ini menjadi .env.local lalu isi dari Firebase Console
# (Project settings > Your apps > SDK setup and configuration > Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opsional (hanya untuk Google Analytics)
VITE_FIREBASE_MEASUREMENT_ID=
# Opsional: isi HANYA bila Database ID di Firebase Console bukan "(default)".
# Cek di Console > Firestore Database > kolom "Database ID".
VITE_FIREBASE_DATABASE_ID=

# Shared secret untuk memanggil Worker AI (diisi nanti di Fase 6)
VITE_AI_WORKER_URL=
VITE_AI_WORKER_TOKEN=

# Opsional: Firebase App Check (reCAPTCHA v3 site key untuk proteksi web produksi)
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Opsional: Google OAuth 2.0 Client ID tipe "Desktop app" untuk login browser sistem di Windows .exe
VITE_GOOGLE_DESKTOP_CLIENT_ID=
