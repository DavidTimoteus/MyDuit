rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function maxNum() {
      return 999999999999999;
    }

    function validDocSize() {
      return request.resource.data.keys().size() <= 25;
    }

    function validBase() {
      let d = request.resource.data;
      return validDocSize()
        && (!('deleted' in d) || d.deleted is bool)
        && (!('deletedAt' in d) || d.deletedAt is timestamp || (d.deletedAt is string && d.deletedAt.size() <= 40))
        && (!('updatedAt' in d) || d.updatedAt is timestamp || (d.updatedAt is string && d.updatedAt.size() <= 40));
    }

    // H-02 (audit 25 Nov 2026): rules sebelumnya hanya memvalidasi BENTUK field
    // yang ADA — deleteField() bisa menghapus field wajib, update bisa menimpa
    // dokumen yang sudah di-soft-delete, dan kursSnapshot/baseCurrency bisa
    // diubah diam-diam. Penjaga di bawah menutup celah itu. Penjaga klien di
    // db.js / backup.js / kurs.js adalah lapis pertama; rules adalah lapis
    // terakhir (defense in depth) karena klien apa pun bisa menulis langsung.

    // True bila dokumen lama belum di-soft-delete (atau belum ada, mis. create).
    function belumDihapus() {
      return resource == null
        || !('deleted' in resource.data)
        || resource.data.deleted != true;
    }

    // Field yang ada di dokumen lama tidak boleh hilang lewat deleteField()
    // pada update. Dokumen legacy yang memang belum punya field itu tidak
    // dipaksa (supaya migrasiNormalisasi tidak terblokir).
    function fieldTetapAda(namaField) {
      return resource == null
        || !(namaField in resource.data)
        || namaField in request.resource.data;
    }

    // Izinkan soft-delete walaupun dokumen lama punya field legacy/oversized.
    function isSoftDelete() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return resource != null
        && keys.hasOnly(['deleted', 'deletedAt', 'updatedAt'])
        && keys.hasAny(['deleted'])
        && d.deleted == true
        && (!keys.hasAny(['deletedAt']) || d.deletedAt is timestamp)
        && (!keys.hasAny(['updatedAt']) || d.updatedAt is timestamp);
    }

    // Kebalikan soft-delete: membatalkan penghapusan (deleted true -> false)
    // tanpa mengubah isi apa pun. Satu-satunya jalan memulihkan dokumen yang
    // di-soft-delete — hard-delete dihapus dari rules (R-01 re-audit), jadi
    // restore tidak lagi menghapus permanen lalu membuat ulang; ia
    // membatalkan flag dulu, lalu set-merge berjalan sebagai update biasa
    // yang tetap dinilai validator (kursSnapshot/baseCurrency tetap terkunci).
    function isUnDelete() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return resource != null
        && resource.data.deleted == true
        && keys.hasOnly(['deleted', 'deletedAt', 'updatedAt'])
        && keys.hasAny(['deleted'])
        && d.deleted == false
        // deletedAt boleh dihapus (deleteField -> tidak ada di dokumen baru)
        // atau diisi timestamp; tidak boleh diisi nilai lain.
        && (!keys.hasAny(['deletedAt']) || !('deletedAt' in d) || d.deletedAt is timestamp)
        && (!keys.hasAny(['updatedAt']) || d.updatedAt is timestamp);
    }

    function validKursSnapshot(d) {
      return !('kursSnapshot' in d) || d.kursSnapshot == null || (
        d.kursSnapshot is map
        && d.kursSnapshot.keys().hasOnly(['basis', 'usdKe', 'tanggal', 'sumber'])
        && (!('basis' in d.kursSnapshot) || (d.kursSnapshot.basis is string && d.kursSnapshot.basis.matches('^[A-Z]{3}$')))
        // Cap 96: menutupi maks sanitasiKursSnapshot (80 kunci + USD yang
        // dipaksa masuk = 81) dan tabel cadangan 56 entri + 1 kunci basis,
        // dengan margin bila tabel bertambah — cap lama 40 menolak semua
        // tulis transaksi bila rules di-deploy (R-01 re-audit).
        // Dijaga test src/lib/snapshotKursRules.test.mjs (membaca cap dari file ini).
        && (!('usdKe' in d.kursSnapshot) || (d.kursSnapshot.usdKe is map && d.kursSnapshot.usdKe.keys().size() <= 96))
        && (!('tanggal' in d.kursSnapshot) || (d.kursSnapshot.tanggal is string && d.kursSnapshot.tanggal.size() <= 20))
        && (!('sumber' in d.kursSnapshot) || (d.kursSnapshot.sumber is string && d.kursSnapshot.sumber.size() <= 60))
      );
    }

    function validTransaksi(isCreate) {
      let d = request.resource.data;
      return validBase()
        && validKursSnapshot(d)
        && (!isCreate || (
          'deleted' in d && d.deleted is bool &&
          'jumlah' in d && (d.deleted == true || d.jumlah > 0) &&
          'jenis' in d &&
          'tanggal' in d && d.tanggal is string && d.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        ))
        // Update tidak boleh menghapus field wajib lewat deleteField().
        && (isCreate || (fieldTetapAda('jumlah') && fieldTetapAda('jenis') && fieldTetapAda('tanggal')))
        // kursSnapshot adalah jejak kurs saat transaksi dibuat — tidak boleh
        // diubah setelahnya (mengubahnya = mengubah arti historis nominal).
        && (isCreate || resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kursSnapshot']))
        && (isCreate || resource == null || !(d.deleted == true && request.resource.data.diff(resource.data).affectedKeys().hasAny(['jumlah', 'akunId', 'dariId', 'keId', 'utangId', 'jenis'])))
        && (!('jumlah' in d) || (d.jumlah is number && d.jumlah >= 0 && d.jumlah <= maxNum()))
        && (!('jenis' in d) || d.jenis in ['pemasukan', 'pengeluaran', 'pindah saldo'])
        && (!('tanggal' in d) || (d.tanggal is string && d.tanggal.size() <= 32 && (isCreate || resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tanggal']) || d.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))))
        && (!('catatan' in d) || (d.catatan is string && d.catatan.size() <= 500));
    }

    function validAkun(isCreate) {
      let d = request.resource.data;
      return validBase()
        && (!isCreate || (
          'deleted' in d && d.deleted is bool &&
          'nama' in d && d.nama is string && d.nama.size() > 0 && d.nama.size() <= 120 &&
          'saldo' in d
        ))
        // Update tidak boleh menghapus nama/tipe/saldo lewat deleteField().
        && (isCreate || (fieldTetapAda('nama') && fieldTetapAda('tipe') && fieldTetapAda('saldo')))
        // R-03 re-audit: perubahan saldo wajib tercatat konsisten — mutasiTerakhir
        // harus ada dan deltanya sama dengan perubahan saldo. Tulis absolut
        // diam-diam (update({saldo: X}) tanpa jejak) ditolak. Ini BUKAN
        // pengganti Cloud Function + rekonsiliasi: penyerang yang tahu aturan
        // bisa menulis pasangan yang konsisten sendiri — tapi jejak audit tetap
        // utuh dan pola satu-field yang paling gampang sudah tertutup.
        // Pengecualian: dokumen legacy yang memang belum punya saldo.
        && (isCreate || resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['saldo'])
          || !('saldo' in resource.data)
          || (('mutasiTerakhir' in d) && d.mutasiTerakhir is map && ('delta' in d.mutasiTerakhir)
            && d.mutasiTerakhir.delta is number
            && d.mutasiTerakhir.delta == d.saldo - resource.data.saldo))
        && (!('saldo' in d) || (d.saldo is number && d.saldo >= -maxNum() && d.saldo <= maxNum()))
        && (!('nama' in d) || (d.nama is string && d.nama.size() <= 120))
        && (!('tipe' in d) || (d.tipe is string && d.tipe.size() <= 60));
    }

    function validKategori(isCreate) {
      let d = request.resource.data;
      return validBase()
        && (!isCreate || (
          'deleted' in d && d.deleted is bool &&
          'nama' in d && d.nama is string && d.nama.size() > 0 && d.nama.size() <= 100
        ))
        // R-02 re-audit: nama tidak boleh hilang lewat deleteField().
        && (isCreate || fieldTetapAda('nama'))
        && (!('nama' in d) || (d.nama is string && d.nama.size() <= 100))
        && (!('jenis' in d) || d.jenis in ['pemasukan', 'pengeluaran', '']);
    }

    function validBudget(isCreate) {
      let d = request.resource.data;
      return validBase()
        && (!isCreate || (
          'deleted' in d && d.deleted is bool &&
          'limitNominal' in d && (d.deleted == true || d.limitNominal > 0) &&
          'bulan' in d &&
          'tahun' in d
        ))
        // R-02 re-audit: limit/bulan/tahun tidak boleh hilang lewat deleteField().
        && (isCreate || (fieldTetapAda('limitNominal') && fieldTetapAda('bulan') && fieldTetapAda('tahun')))
        && (!('limitNominal' in d) || (d.limitNominal is number && d.limitNominal >= 0 && d.limitNominal <= maxNum()))
        && (!('bulan' in d) || (d.bulan is int && d.bulan >= 0 && d.bulan <= 11))
        && (!('tahun' in d) || (d.tahun is int && d.tahun >= 2000 && d.tahun <= 2100));
    }

    function validUtang(isCreate) {
      let d = request.resource.data;
      return validBase()
        && (!isCreate || (
          'deleted' in d && d.deleted is bool &&
          'namaPihak' in d && d.namaPihak is string && d.namaPihak.size() > 0 && d.namaPihak.size() <= 150 &&
          'total' in d &&
          'sisa' in d
        ))
        // R-02 re-audit: identitas + nominal tidak boleh hilang lewat deleteField().
        && (isCreate || (fieldTetapAda('namaPihak') && fieldTetapAda('total') && fieldTetapAda('sisa')))
        && (!('namaPihak' in d) || (d.namaPihak is string && d.namaPihak.size() <= 150))
        && (!('deskripsi' in d) || (d.deskripsi is string && d.deskripsi.size() <= 500))
        && (!('total' in d) || (d.total is number && d.total > 0 && d.total <= maxNum()))
        && (!('sisa' in d) || (d.sisa is number && d.sisa >= 0 && d.sisa <= maxNum()))
        && (!('sisa' in d && 'total' in d) || d.sisa <= d.total)
        && (!('status' in d) || d.status in ['Belum Lunas', 'Lunas'])
        && (!('cicilanPerBulan' in d) || (d.cicilanPerBulan is number && d.cicilanPerBulan >= 0 && d.cicilanPerBulan <= maxNum()))
        && (!('tipe' in d) || d.tipe in ['Utang', 'Cicilan'])
        && (!('tglJatuhTempo' in d) || (d.tglJatuhTempo is string && d.tglJatuhTempo.size() <= 32));
    }

    function validPembayaranUtang(isCreate) {
      let d = request.resource.data;
      return validBase()
        && validKursSnapshot(d)
        && (!isCreate || ('deleted' in d && d.deleted is bool && 'jumlah' in d && (d.deleted == true || d.jumlah > 0)))
        // R-02 re-audit: jumlah tidak boleh hilang lewat deleteField().
        && (isCreate || fieldTetapAda('jumlah'))
        // Sama seperti transaksi: kursSnapshot tidak boleh diubah setelah dibuat.
        && (isCreate || resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['kursSnapshot']))
        && (!('jumlah' in d) || (d.jumlah is number && d.jumlah >= 0 && d.jumlah <= maxNum()))
        && (!('tanggal' in d) || (d.tanggal is string && d.tanggal.size() <= 32));
    }

    function validMutasiLog() {
      let d = request.resource.data;
      return validBase()
        && (!('delta' in d) || (d.delta is number && d.delta >= -maxNum() && d.delta <= maxNum()));
    }

    function validMeta() {
      let d = request.resource.data;
      return d.keys().hasOnly(['done', 'at', 'baseCurrency', 'updatedAt', 'deleted', 'deletedAt'])
        && (!('done' in d) || d.done is bool)
        && (!('at' in d) || d.at is timestamp || (d.at is string && d.at.size() <= 40))
        && (!('baseCurrency' in d) || (d.baseCurrency is string && d.baseCurrency.matches('^[A-Z]{3}$')))
        && (!('updatedAt' in d) || d.updatedAt is timestamp || (d.updatedAt is string && d.updatedAt.size() <= 40))
        // Basis mata uang yang sudah tersimpan (format valid) TIDAK boleh
        // diganti lewat update — menggantinya tanpa konversi membuat semua
        // angka lama salah label. Pengecualian: basis lama tidak ada atau
        // formatnya rusak (jalur perbaikan). Basis yang valid tapi tidak
        // didukung klien TIDAK bisa diganti lewat klien sama sekali sejak
        // hard-delete dihapus (R-01 re-audit) — perbaikannya butuh jalur
        // admin/Cloud Function, bukan delete lalu buat ulang.
        && (resource == null || !('baseCurrency' in resource.data)
          || !(resource.data.baseCurrency is string && resource.data.baseCurrency.matches('^[A-Z]{3}$'))
          || ('baseCurrency' in d && d.baseCurrency == resource.data.baseCurrency));
    }

    // H-02: update pada dokumen yang sudah di-soft-delete ditolak di server
    // (perlindungan double-delete / update-setelah-hapus). Soft-delete pertama
    // tetap lolos lewat isSoftDelete(); percobaan kedua gagal karena dokumen
    // sudah deleted dan isSoftDelete() butuh perubahan field deleted.
    // R-01 re-audit: `allow delete` DIHAPUS dari semua koleksi. Hard-delete
    // + create ulang ID yang sama melewati semua perlindungan update
    // (kursSnapshot immutable, kunci baseCurrency, belumDihapus) karena create
    // tidak tahu dokumen itu pernah ada. Penghapusan kini hanya soft-delete;
    // pemulihan lewat isUnDelete() (bendera saja); purge permanen butuh
    // Cloud Function dengan re-autentikasi + masa tenggang (belum ada).
    match /users/{uid}/transaksi/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validTransaksi(true);
      allow update: if isOwner(uid) && (isSoftDelete() || isUnDelete() || (belumDihapus() && validTransaksi(false)));
    }

    match /users/{uid}/akun/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validAkun(true);
      allow update: if isOwner(uid) && (isSoftDelete() || isUnDelete() || (belumDihapus() && validAkun(false)));
    }

    match /users/{uid}/kategori/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validKategori(true);
      allow update: if isOwner(uid) && (isSoftDelete() || isUnDelete() || (belumDihapus() && validKategori(false)));
    }

    match /users/{uid}/budget/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validBudget(true);
      allow update: if isOwner(uid) && (isSoftDelete() || isUnDelete() || (belumDihapus() && validBudget(false)));
    }

    match /users/{uid}/utang/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validUtang(true);
      allow update: if isOwner(uid) && (isSoftDelete() || isUnDelete() || (belumDihapus() && validUtang(false)));
    }

    match /users/{uid}/pembayaranUtang/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validPembayaranUtang(true);
      allow update: if isOwner(uid) && (isSoftDelete() || isUnDelete() || (belumDihapus() && validPembayaranUtang(false)));
    }

    // M-02 re-audit: mutasiLog append-only di sisi isi — update hanya boleh
    // membalik bendera (soft-delete / un-delete) atau tanpa perubahan sama
    // sekali (no-op, mis. merge-set restore atas dokumen yang sudah identik).
    // delta/aksi/timestamp tidak bisa diubah maupun dihapus lewat update.
    match /users/{uid}/mutasiLog/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validMutasiLog();
      allow update: if isOwner(uid) && (isSoftDelete() || isUnDelete() || request.resource.data.diff(resource.data).affectedKeys().size() == 0);
    }

    match /users/{uid}/meta/{docId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validMeta();
      allow update: if isOwner(uid) && (isSoftDelete() || isUnDelete() || validMeta());
    }

    // Semua jalur lain (termasuk subkoleksi asing atau koleksi root lain) ditolak eksplisit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
