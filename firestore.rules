rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function maxNum() {
      return 999999999999999;
    }

    function validDocSize() {
      return request.resource.data.keys().size() <= 25;
    }

    function validBase() {
      let d = request.resource.data;
      return validDocSize()
        && (!('deleted' in d) || d.deleted is bool)
        && (!('deletedAt' in d) || d.deletedAt is timestamp || (d.deletedAt is string && d.deletedAt.size() <= 40))
        && (!('updatedAt' in d) || d.updatedAt is timestamp || (d.updatedAt is string && d.updatedAt.size() <= 40));
    }

    // Izinkan soft-delete walaupun dokumen lama punya field legacy/oversized.
    function isSoftDelete() {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      return resource != null
        && keys.hasOnly(['deleted', 'deletedAt', 'updatedAt'])
        && keys.hasAny(['deleted'])
        && d.deleted == true
        && (!keys.hasAny(['deletedAt']) || d.deletedAt is timestamp)
        && (!keys.hasAny(['updatedAt']) || d.updatedAt is timestamp);
    }

    function validKursSnapshot(d) {
      return !('kursSnapshot' in d) || d.kursSnapshot == null || (
        d.kursSnapshot is map
        && d.kursSnapshot.keys().hasOnly(['basis', 'usdKe', 'tanggal', 'sumber'])
        && (!('basis' in d.kursSnapshot) || (d.kursSnapshot.basis is string && d.kursSnapshot.basis.matches('^[A-Z]{3}$')))
        && (!('usdKe' in d.kursSnapshot) || (d.kursSnapshot.usdKe is map && d.kursSnapshot.usdKe.keys().size() <= 40))
        && (!('tanggal' in d.kursSnapshot) || (d.kursSnapshot.tanggal is string && d.kursSnapshot.tanggal.size() <= 20))
        && (!('sumber' in d.kursSnapshot) || (d.kursSnapshot.sumber is string && d.kursSnapshot.sumber.size() <= 60))
      );
    }

    function validTransaksi(isCreate) {
      let d = request.resource.data;
      return validBase()
        && validKursSnapshot(d)
        && (!isCreate || (
          'deleted' in d && d.deleted is bool &&
          'jumlah' in d && (d.deleted == true || d.jumlah > 0) &&
          'jenis' in d &&
          'tanggal' in d && d.tanggal is string && d.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        ))
        && (isCreate || resource == null || !(d.deleted == true && request.resource.data.diff(resource.data).affectedKeys().hasAny(['jumlah', 'akunId', 'dariId', 'keId', 'utangId', 'jenis'])))
        && (!('jumlah' in d) || (d.jumlah is number && d.jumlah >= 0 && d.jumlah <= maxNum()))
        && (!('jenis' in d) || d.jenis in ['pemasukan', 'pengeluaran', 'pindah saldo'])
        && (!('tanggal' in d) || (d.tanggal is string && d.tanggal.size() <= 32 && (isCreate || resource == null || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tanggal']) || d.tanggal.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))))
        && (!('catatan' in d) || (d.catatan is string && d.catatan.size() <= 500));
    }

    function validAkun(isCreate) {
      let d = request.resource.data;
      return validBase()
        && (!isCreate || (
          'deleted' in d && d.deleted is bool &&
          'nama' in d && d.nama is string && d.nama.size() > 0 && d.nama.size() <= 120 &&
          'saldo' in d
        ))
        && (!('saldo' in d) || (d.saldo is number && d.saldo >= -maxNum() && d.saldo <= maxNum()))
        && (!('nama' in d) || (d.nama is string && d.nama.size() <= 120))
        && (!('tipe' in d) || (d.tipe is string && d.tipe.size() <= 60));
    }

    function validKategori(isCreate) {
      let d = request.resource.data;
      return validBase()
        && (!isCreate || (
          'deleted' in d && d.deleted is bool &&
          'nama' in d && d.nama is string && d.nama.size() > 0 && d.nama.size() <= 100
        ))
        && (!('nama' in d) || (d.nama is string && d.nama.size() <= 100))
        && (!('jenis' in d) || d.jenis in ['pemasukan', 'pengeluaran', '']);
    }

    function validBudget(isCreate) {
      let d = request.resource.data;
      return validBase()
        && (!isCreate || (
          'deleted' in d && d.deleted is bool &&
          'limitNominal' in d && (d.deleted == true || d.limitNominal > 0) &&
          'bulan' in d &&
          'tahun' in d
        ))
        && (!('limitNominal' in d) || (d.limitNominal is number && d.limitNominal >= 0 && d.limitNominal <= maxNum()))
        && (!('bulan' in d) || (d.bulan is int && d.bulan >= 0 && d.bulan <= 11))
        && (!('tahun' in d) || (d.tahun is int && d.tahun >= 2000 && d.tahun <= 2100));
    }

    function validUtang(isCreate) {
      let d = request.resource.data;
      return validBase()
        && (!isCreate || (
          'deleted' in d && d.deleted is bool &&
          'namaPihak' in d && d.namaPihak is string && d.namaPihak.size() > 0 && d.namaPihak.size() <= 150 &&
          'total' in d &&
          'sisa' in d
        ))
        && (!('namaPihak' in d) || (d.namaPihak is string && d.namaPihak.size() <= 150))
        && (!('deskripsi' in d) || (d.deskripsi is string && d.deskripsi.size() <= 500))
        && (!('total' in d) || (d.total is number && d.total > 0 && d.total <= maxNum()))
        && (!('sisa' in d) || (d.sisa is number && d.sisa >= 0 && d.sisa <= maxNum()))
        && (!('sisa' in d && 'total' in d) || d.sisa <= d.total)
        && (!('status' in d) || d.status in ['Belum Lunas', 'Lunas'])
        && (!('cicilanPerBulan' in d) || (d.cicilanPerBulan is number && d.cicilanPerBulan >= 0 && d.cicilanPerBulan <= maxNum()))
        && (!('tipe' in d) || d.tipe in ['Utang', 'Cicilan'])
        && (!('tglJatuhTempo' in d) || (d.tglJatuhTempo is string && d.tglJatuhTempo.size() <= 32));
    }

    function validPembayaranUtang(isCreate) {
      let d = request.resource.data;
      return validBase()
        && validKursSnapshot(d)
        && (!isCreate || ('deleted' in d && d.deleted is bool && 'jumlah' in d && (d.deleted == true || d.jumlah > 0)))
        && (!('jumlah' in d) || (d.jumlah is number && d.jumlah >= 0 && d.jumlah <= maxNum()))
        && (!('tanggal' in d) || (d.tanggal is string && d.tanggal.size() <= 32));
    }

    function validMutasiLog() {
      let d = request.resource.data;
      return validBase()
        && (!('delta' in d) || (d.delta is number && d.delta >= -maxNum() && d.delta <= maxNum()));
    }

    function validMeta() {
      let d = request.resource.data;
      return d.keys().hasOnly(['done', 'at', 'baseCurrency', 'updatedAt'])
        && (!('done' in d) || d.done is bool)
        && (!('at' in d) || d.at is timestamp || (d.at is string && d.at.size() <= 40))
        && (!('baseCurrency' in d) || (d.baseCurrency is string && d.baseCurrency.matches('^[A-Z]{3}$')))
        && (!('updatedAt' in d) || d.updatedAt is timestamp || (d.updatedAt is string && d.updatedAt.size() <= 40));
    }

    match /users/{uid}/transaksi/{docId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validTransaksi(true);
      allow update: if isOwner(uid) && (isSoftDelete() || validTransaksi(false));
    }

    match /users/{uid}/akun/{docId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validAkun(true);
      allow update: if isOwner(uid) && (isSoftDelete() || validAkun(false));
    }

    match /users/{uid}/kategori/{docId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validKategori(true);
      allow update: if isOwner(uid) && (isSoftDelete() || validKategori(false));
    }

    match /users/{uid}/budget/{docId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validBudget(true);
      allow update: if isOwner(uid) && (isSoftDelete() || validBudget(false));
    }

    match /users/{uid}/utang/{docId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validUtang(true);
      allow update: if isOwner(uid) && (isSoftDelete() || validUtang(false));
    }

    match /users/{uid}/pembayaranUtang/{docId} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && validPembayaranUtang(true);
      allow update: if isOwner(uid) && (isSoftDelete() || validPembayaranUtang(false));
    }

    match /users/{uid}/mutasiLog/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && (isSoftDelete() || validMutasiLog());
    }

    match /users/{uid}/meta/{docId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validMeta();
    }

    // Semua jalur lain (termasuk subkoleksi asing atau koleksi root lain) ditolak eksplisit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
