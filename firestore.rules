rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Validasi integritas dasar payload: field `deleted` bila ada wajib boolean,
    // dan `jumlah` bila ada wajib numerik non-negatif. Tetap kompatibel dengan
    // operasi patch/merge parsial (migrasiNormalisasi & soft-delete).
    function validPayload() {
      return (!('deleted' in request.resource.data) || request.resource.data.deleted is bool)
        && (!('jumlah' in request.resource.data) || (request.resource.data.jumlah is number && request.resource.data.jumlah >= 0));
    }

    // Isolasi data per-user: setiap pengguna hanya punya akses penuh pada
    // dokumen di dalam users/{uid}/... miliknya sendiri.
    match /users/{uid}/{document=**} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPayload();
    }

    // Semua jalur lain ditolak eksplisit. Tanpa aturan ini, penambahan
    // koleksi di luar users/ di masa depan akan terbuka secara diam-diam.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
